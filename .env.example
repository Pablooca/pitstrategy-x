# ------------------------------------------------------------------------
# PITSTRATEGY-X ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting services locally.
# ------------------------------------------------------------------------

# System Environment
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_DB=pitstrategy_db
POSTGRES_USER=pit_admin
POSTGRES_PASSWORD=pit_secret_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Apache Kafka Streaming Cluster
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:9081

# Core Orchestration (Java 21 Spring Boot + Camunda)
SPRING_PROFILES_ACTIVE=dev
CAMUNDA_BPM_ADMIN_USER=admin
CAMUNDA_BPM_ADMIN_PASSWORD=admin

# Engine Simulation (C + CUDA + FastAPI Wrapper)
CUDA_DEVICE_ID=0
SIMULATION_MONTE_CARLO_ITERATIONS=100000
ENGINE_API_PORT=8000

# Telemetry Ingestion Ports
UDP_RECEIVER_PORT=20777
FASTF1_CACHE_DIR=./.fastf1_cache